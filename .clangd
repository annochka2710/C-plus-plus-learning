CompileFlags:
  CompilationDatabase: build/debug
  # used for files that are not in compile_commands.json yet (e.g. a fresh header)
  # --target makes any clangd build (even an MSVC-targeted one) look for the MinGW libstdc++ headers
  Add: [-std=c++20, -Wall, -Wextra, --target=x86_64-w64-windows-gnu]
Diagnostics:
  UnusedIncludes: Strict
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
